<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="8dp" android:background="@drawable/widget_background" android:layoutDirection="locale">
 <LinearLayout android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
  <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⌛ אני פרווה" android:textColor="@color/widget_text" android:textStyle="bold" android:textSize="14sp" android:gravity="center" android:padding="4dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layoutDirection="rtl">
   <Button android:id="@+id/widget_meat" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="בשרי" android:textColor="#FFFFFF" android:background="@drawable/widget_meat"/>
   <Button android:id="@+id/widget_dairy" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="חלבי" android:textColor="#FFFFFF" android:background="@drawable/widget_dairy"/>
  </LinearLayout>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_active" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
  <TextView android:id="@+id/widget_add" android:layout_width="match_parent" android:layout_height="36dp" android:text="+ הוסף טיימר" android:textColor="@color/widget_text" android:textStyle="bold" android:gravity="center" android:background="@drawable/widget_background"/>
  <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#55776655" android:dividerHeight="1dp" android:scrollbars="vertical"/>
  <TextView android:id="@+id/widget_list_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="אין טיימרים פעילים" android:visibility="gone" android:gravity="center" android:textColor="@color/widget_text"/>
 </LinearLayout>
</LinearLayout>